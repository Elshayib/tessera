{
  "name": "tessera",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@tessera/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && pnpm depcruise && pnpm knip",
    "lint:fix": "biome check --write .",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages apps",
    "knip": "knip",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @tessera/web test:e2e",
    "eval:replay": "pnpm --filter @tessera/evals eval --mode replay",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@changesets/cli": "2.29.6",
    "@types/node": "24.3.1",
    "@vitest/coverage-v8": "3.2.4",
    "dependency-cruiser": "16.10.4",
    "knip": "5.63.1",
    "lefthook": "1.13.0",
    "tsx": "4.20.5",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
