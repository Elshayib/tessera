{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignore": ["**/dist/**", "**/coverage/**", "**/.turbo/**", "**/generated/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "complexity": {
        "noBannedTypes": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "useImportType": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/routes/**", "apps/docs/**"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    }
  ]
}
