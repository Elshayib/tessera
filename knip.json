{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "**/generated/**",
    "**/dist/**",
    "docs/templates/**",
    "packages/exporters/fixtures/**",
    "apps/web/src/engine-entry.ts"
  ],
  "ignoreDependencies": ["lefthook"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/main.tsx", "src/flags.ts", "src/bootstrap.ts"],
      "project": ["src/**"]
    }
  }
}
