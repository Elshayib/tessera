{
  "name": "@tessera/agent",
  "version": "0.0.0",
  "description": "Agent runtime: capability probing, roles, tools, and the observe-plan-act loop.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "development": "./src/observability.ts",
      "import": "./dist/observability.js",
      "default": "./dist/observability.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@tessera/assets": "workspace:*",
    "@tessera/core": "workspace:*",
    "@tessera/llm": "workspace:*",
    "@tessera/schema": "workspace:*",
    "@tessera/spatial": "workspace:*",
    "@tessera/std": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tessera/testing": "workspace:*",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
