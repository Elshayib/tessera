{
  "name": "@tessera/schema",
  "version": "0.0.0",
  "description": "Zod 4 document schema, command/query catalogs, inspector metadata, and JSON Schema emit for Tessera.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./json-schema": {
      "types": "./dist/json-schema.d.ts",
      "development": "./src/json-schema.ts",
      "import": "./dist/json-schema.js",
      "default": "./dist/json-schema.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "emit-json-schema": "tsx ../../scripts/emit-json-schema.ts"
  },
  "dependencies": {
    "@tessera/std": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
